+def getcolumns(default, fields):
+    '''Resolve -c, including "all" and "+column" additions.
+
+    Adapted from G-dH/smem. A leading "+" on every name appends those
+    columns to the view's default set instead of replacing it.
+    '''
+    spec = (options.columns or '').strip()
+    if not spec:
+        return default
+    if spec == 'all':
+        ordered = default.split()
+        ordered += [key for key in fields if key not in ordered]
+        return ' '.join(ordered)
+    parts = spec.split()
+    if parts and all(part.startswith('+') and len(part) > 1 for part in parts):
+        return default + ' ' + ' '.join(part[1:] for part in parts)
+    return spec
