+def cmdtotals(pids):
+    '''Sum memory of processes that share the same executable.'''
+    totals = {}
+    for pid in pids:
+        if (filters(options.processfilter, pid, src.pidname, src.pidcmd, pidtostr) or
+                filters(options.userfilter, pid, pidusername)):
+            continue
+        try:
+            pt = pidtotals(pid)
+            if pt['maps'] == 0:
+                continue
+            parts = src.pidcmd(pid).split()
+            if not parts:
+                continue
+            cmd = parts[0]
+        except:
+            continue
+        if cmd not in totals:
+            t = dict(size=0, rss=0, pss=0, uss=0, shared_clean=0,
+                     shared_dirty=0, private_clean=0, private_dirty=0,
+                     referenced=0, swap=0, pids=0)
+            _zero_extra(t)
+        else:
+            t = totals[cmd]
+        for k in list(t):
+            if k == 'pids':
+                continue
+            t[k] += pt.get(k, 0)
+        t['pids'] += 1
+        totals[cmd] = t
+    return totals
 
