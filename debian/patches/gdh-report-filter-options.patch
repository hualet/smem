+def _physical_ram_kb():
+    '''Sum DIMM sizes reported by dmidecode, in kB.
+
+    Used only for the system overview, and only when --realmem is not set.
+    Adapted from G-dH/smem.
+    '''
+    try:
+        out = subprocess.check_output(
+            ['dmidecode', '--type', 'memory'],
+            stderr=subprocess.DEVNULL, timeout=5)
+    except Exception:
+        return None
+    total_mb = 0
+    for line in out.decode('utf-8', 'replace').splitlines():
+        line = line.strip()
+        if not line.startswith('Size:') or not line.endswith('MB'):
+            continue
+        parts = line.split()
+        if len(parts) >= 3 and parts[1].isdigit():
+            total_mb += int(parts[1])
+    if total_mb <= 0:
+        return None
+    return total_mb * 1024
