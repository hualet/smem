+def mapdevzero():
+    '''PSS of /dev/zero mappings.
+
+    Some kernels count memory initialized from /dev/zero as file-backed
+    Mapped. The system view subtracts it. Adapted from G-dH/smem.
+    '''
+    global ROLLUP
+    saved_rollup = ROLLUP
+    saved_filter = options.mapfilter
+    ROLLUP = False
+    options.mapfilter = '^/dev/zero$'
+    try:
+        pt = maptotals(src.pids())
+    except Exception:
+        pt = {}
+    finally:
+        ROLLUP = saved_rollup
+        options.mapfilter = saved_filter
+    return int(sum(row.get('pss', 0) for row in pt.values()))
+
+def mapshared():
+    '''Shmem PSS charged to processes, from smaps_rollup when available.'''
+    global ROLLUP
+    if not PSSDETAIL:
+        return 0
+    saved = ROLLUP
+    ROLLUP = True
+    try:
+        total = 0
+        for row in processtotals(src.pids()).values():
+            total += row.get('pss_shmem', 0)
+        return int(total)
+    finally:
+        ROLLUP = saved
+
+def kernelmodsize():
+    '''Kernel module text/data, in kB, from /proc/modules.'''
+    total = 0
+    try:
+        lines = src._readlines('modules')
+    except Exception:
+        if not getattr(options, 'quiet', False):
+            sys.stderr.write('warning: detection of kernel modules size failed\n')
+        return 0
+    try:
+        for line in lines:
+            parts = line.split()
+            if len(parts) >= 2:
+                total += int(parts[1])
+    except Exception:
+        if not getattr(options, 'quiet', False):
+            sys.stderr.write('warning: detection of kernel modules size failed\n')
+        return 0
+    return int(total / 1024)
+
+def _ramfs_kb():
+    total = 0
+    try:
+        mounts = src._readlines('mounts')
+    except Exception:
+        return 0
+    for line in mounts:
+        parts = line.split()
+        if len(parts) < 3 or parts[2] != 'ramfs':
+            continue
+        try:
+            out = subprocess.check_output(
+                ['du', '-sk', parts[1]],
+                stderr=subprocess.DEVNULL, timeout=10)
+            total += int(out.split()[0])
+        except Exception:
+            pass
+    return total
+
