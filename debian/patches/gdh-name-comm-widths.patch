+def pidtostr(pid):
+    return str(pid)
+
+ignore_autosize = set()
+
+def widthstr(field, width, default):
+    '''Format for a text column.
+
+    width < 0 uses the historical default. width == 0 prints the full
+    value. A positive width truncates and is left alone by --autosize.
+    Adapted from G-dH/smem.
+    '''
+    if width == 0:
+        return '%s'
+    if width < 0:
+        size = default
+    else:
+        size = width
+        ignore_autosize.add(field)
+    return '%%-%d.%ds' % (size, size)
+
